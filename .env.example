# Supabase — optional. Leave these unset to run the school records on the
# server's own store; the public website's published content is read from these
# tables (see supabase/schema.sql), so the site shows empty states until the
# school_information row and the content tables are filled.
#
# With a project connected, staff sign in through Supabase Auth and the
# portal's staff directory creates, edits and suspends those accounts through
# the Supabase admin API. The service-role key is read on the server only.
# Enable Email under Authentication → Providers in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to sign staff portal sessions. Set a long random value in production.
AUTH_SECRET=

# School particulars (name, contacts, notices, term dates, departments and the
# rest) live in the database, not in environment variables. Publish them by
# running the inserts at the foot of supabase/schema.sql.
