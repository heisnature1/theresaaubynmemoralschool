# Supabase Configuration for St. Teresa Aubyn Memorial School
# Create a project at https://supabase.com and run supabase/schema.sql in the SQL Editor

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Settings
NEXT_PUBLIC_SCHOOL_NAME="St. Teresa Aubyn Memorial School"
NEXT_PUBLIC_CURRENT_SEMESTER="2026/2027 - First Semester"
