# Supabase — optional. Leave these unset to run the school records on the
# server's own store, which is how the portal runs out of the box.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to sign staff portal sessions. Set a long random value in production.
AUTH_SECRET=

# School details shown across the site
NEXT_PUBLIC_SCHOOL_NAME="St. Teresa Aubyn Memorial School"
NEXT_PUBLIC_CURRENT_SEMESTER="2026/2027 - First Semester"
